generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Candidate {
  id                  Int      @id @default(autoincrement())
  fullName            String
  email               String
  phone               String?
  desiredArea         String?
  professionalSummary String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}